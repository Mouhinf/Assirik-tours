{
  "name": "assirik-tours",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate || true",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:services": "tsx scripts/seed-services.ts",
    "seed:testimonials": "tsx scripts/seed-testimonials.ts",
    "seed:blog": "tsx scripts/seed-blog.ts",
    "seed:regions": "tsx scripts/seed-regions.ts",
    "seed:all": "tsx scripts/seed.ts && tsx scripts/seed-regions.ts && tsx scripts/seed-services.ts && tsx scripts/seed-about-page.ts",
    "seed:about": "tsx scripts/seed-about-page.ts",
    "migrate:about-year": "tsx scripts/migrate-about-year.ts",
    "migrate:about-credentials": "tsx scripts/migrate-about-credentials.ts",
    "migrate:reservation-source": "tsx scripts/migrate-reservation-source.ts",
    "migrate:request-processing": "prisma db execute --schema prisma/schema.prisma --file scripts/migrate-request-processing.sql"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "next": "16.3.3",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "lighthouse": "^13.4.1",
    "prisma": "6.19.3",
    "puppeteer": "^25.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0"
}
