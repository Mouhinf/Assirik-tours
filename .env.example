# =====================================================
# Assirik Tours — Environment variables
# Copy to .env.local and fill in real values.
# =====================================================

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=221775495314

# Auth — generate with: openssl rand -hex 32
AUTH_SECRET=

# Database (Neon / Supabase / Vercel Postgres — free tier)
DATABASE_URL="postgresql://user:password@host:5432/assiriktours?sslmode=require"

# Cloudinary (free tier — 25 credits/month)
# Find these in https://console.cloudinary.com/
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=