// Assirik Tours — database schema
//
// Phase 1 MVP scope:
//   - Destination catalogue (Sénégal + international)
//   - Offres/Forfaits with pricing and availability
//   - Réservations from the public site
//   - Clients (linked to reservations)
//   - Admin users (single role for now — RBAC in Phase 2)
//
// Storage: PostgreSQL via Neon (free tier) or Supabase.
// File uploads (visa docs, photos): Cloudinary (signed URLs).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Catalogue ─────────────────────────────────────────────────────────

enum DestinationRegion {
  DAKAR
  NIAYES
  PETITE_COTE
  CASAMANCE
  SENEGAL_ORIENTAL
  SAINT_LOUIS
  AFRIQUE_OUEST
  EUROPE
  MOYEN_ORIENT
  ASIE
  AMERIQUE
}

model Destination {
  id          String              @id @default(cuid())
  slug        String              @unique
  title       String
  region      DestinationRegion
  summary     String
  description String?             @db.Text
  heroImageId String?             // Cloudinary public_id
  gallery     String[]            @default([]) // Cloudinary public_ids
  published   Boolean             @default(false)
  featured    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  offers Offer[]

  @@index([region])
  @@index([published, featured])
}

// ── Offres ─────────────────────────────────────────────────────────────

enum OfferKind {
  SEJOUR
  CIRCUIT
  SUR_MESURE
  OMRA
  HAJJ
  BILLETERIE
}

model Offer {
  id            String      @id @default(cuid())
  slug          String      @unique
  title         String
  kind          OfferKind
  summary       String
  description   String?     @db.Text
  priceFCFA     Int         // in FCFA, integer (no decimals)
  durationDays  Int?
  maxGuests     Int?
  coverImageId  String?
  gallery       String[]    @default([])
  published     Boolean     @default(false)
  startDate     DateTime?
  endDate       DateTime?

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  reservations  Reservation[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([destinationId, published])
  @@index([kind, published])
}

// ── Réservations ──────────────────────────────────────────────────────

enum ReservationStatus {
  NOUVELLE
  EN_COURS
  CONFIRMEE
  PAYEE
  ANNULEE
  TERMINEE
}

model Client {
  id          String        @id @default(cuid())
  firstName   String
  lastName    String
  email       String        @unique
  phone       String
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())

  reservations Reservation[]
}

model Reservation {
  id            String            @id @default(cuid())
  reference     String            @unique // e.g. "AT-2026-00042"
  status        ReservationStatus @default(NOUVELLE)
  clientAccountId String?
  clientAccount ClientAccount?    @relation("ClientAccountReservations", fields: [clientAccountId], references: [id], onDelete: SetNull)

  // Snapshot of the trip at booking time
  travelers     Int               @default(1)
  startDate     DateTime?
  totalFCFA     Int
  notes         String?           @db.Text

  clientId      String
  client        Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)

  offerId       String?
  offer         Offer?            @relation(fields: [offerId], references: [id], onDelete: SetNull)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ── Auth (admin) ──────────────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  AGENT
  COMPTABLE
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         AdminRole  @default(AGENT)
  twoFactorEnabled Boolean @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ── Visa dossiers (Phase 2 — structure in place) ───────────────────────

enum VisaStatus {
  BROUILLON
  DOCUMENTS_MANQUANTS
  EN_TRAITEMENT
  ACCEPTE
  REFUSE
}

model VisaDossier {
  id            String      @id @default(cuid())
  reference     String      @unique
  destination   String      // e.g. "Schengen", "USA", "Canada"
  visaType      String?     // e.g. "court séjour", "long séjour", "Omra"
  status        VisaStatus  @default(BROUILLON)
  deadline      DateTime?
  appointmentAt DateTime?
  documents     Json        @default("[]") // [{name, cloudinaryId, uploadedAt}]
  feeFCFA       Int         @default(0)
  paid          Boolean     @default(false)
  clientId      String      // FK to Client
  clientAccountId String?
  clientAccount ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([clientId])
  @@index([status])
}

// ── Témoignages ───────────────────────────────────────────────────────

model Testimonial {
  id        String   @id @default(cuid())
  author    String
  city      String?
  content   String   @db.Text
  rating    Int      @default(5)
  tripSlug  String?
  approved  Boolean  @default(false)
  locale    String   @default("fr")        // "fr" | "en" — display language
  avatarId  String?                        // Cloudinary public_id (avatar optionnel)
  dateTrip  DateTime?                      // date du voyage (optionnel, jamais dans le futur)
  order     Int      @default(0)           // tri manuel sur la home
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approved, locale, order])
}
// ── RBAC extensions ─────────────────────────────────────────────

model TwoFactorCode {
  id        String   @id @default(cuid())
  userId    String
  secret    String   // encrypted at rest in production
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
  lastUsed  DateTime?

  @@unique([userId])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // e.g. "reservation.create", "offer.publish"
  entity    String?  // e.g. "reservation:abc123"
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model ClientAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  emailVerified Boolean @default(false)
  verifyToken  String?
  resetToken   String?
  resetExpires DateTime?
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  reservations Reservation[] @relation("ClientAccountReservations")
  visaDossiers VisaDossier[]
}

// ── Site settings (mini-CMS singleton) ────────────────────────

model SiteSetting {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt
}
