// Assirik Tours — database schema
//
// Phase 1 MVP scope:
//   - Destination catalogue (Sénégal + international)
//   - Offres/Forfaits with pricing and availability
//   - Réservations from the public site
//   - Clients (linked to reservations)
//   - Admin users (single role for now — RBAC in Phase 2)
//
// Storage: PostgreSQL via Neon (free tier) or Supabase.
// File uploads (visa docs, photos): Cloudinary (signed URLs).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Catalogue ─────────────────────────────────────────────────────────

enum DestinationRegion {
  DAKAR
  NIAYES
  PETITE_COTE
  CASAMANCE
  SENEGAL_ORIENTAL
  SAINT_LOUIS
  AFRIQUE_OUEST
  EUROPE
  MOYEN_ORIENT
  ASIE
  AMERIQUE
}

model Destination {
  id             String            @id @default(cuid())
  slug           String            @unique
  title          String
  region         DestinationRegion
  summary        String
  description    String?           @db.Text
  heroImageId    String? // Cloudinary public_id
  gallery        String[]          @default([]) // Cloudinary public_ids
  published      Boolean           @default(false)
  featured       Boolean           @default(false)
  homeOrder      Int? // null = masqué en accueil. Sinon trié par ordre croissant.
  // Optional FK to an admin-managed Region row (used when the region
  // does not map to a value in the DestinationRegion enum).
  customRegionId String?
  customRegion   Region?           @relation("DestinationCustomRegion", fields: [customRegionId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  offers       Offer[]
  reservations Reservation[] @relation("DestinationReservations")

  @@index([region])
  @@index([published, featured])
  @@index([customRegionId])
}

// ── Régions (admin-gérées) ────────────────────────────────────────────────

model Region {
  id             String   @id @default(cuid())
  slug           String   @unique
  labelFr        String
  labelEn        String
  /// "senegal" | "international" — used to group the filter UI.
  group          String   @default("international")
  /// Legacy enum values that match this Region. A Destination with `region`
  /// set to one of these keys will be included when this Region is selected
  /// in the public filter. Empty for fully custom regions.
  legacyEnumKeys String[] @default([])
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  destinations Destination[] @relation("DestinationCustomRegion")

  @@index([isActive, order])
}

// ── Offres ─────────────────────────────────────────────────────────────

enum OfferKind {
  SEJOUR
  CIRCUIT
  SUR_MESURE
  OMRA
  HAJJ
  BILLETERIE
}

model Offer {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  kind             OfferKind
  summary          String
  description      String?   @db.Text
  priceFCFA        Int // in FCFA, integer (no decimals)
  durationDays     Int?
  maxGuests        Int?
  coverImageId     String?
  gallery          String[]  @default([])
  inclusions       String[]  @default([]) // "Vols A/R", "Hébergement 7 nuits", ...
  exclusions       String[]  @default([]) // "Boissons", "Pourboires", ...
  /// Promotional pricing. When set and not expired, displayed as the current
  /// price on the public site (with `priceFCFA` shown as the strikethrough).
  promoPriceFCFA   Int?
  promoEndsAt      DateTime?
  /// "ON_DEMAND" (sur devis, no stock cap) | "FIXED_STOCK" (limited seats)
  availabilityType String    @default("ON_DEMAND")
  /// Remaining seats. Required when availabilityType = "FIXED_STOCK".
  stock            Int?
  featuredOnHome   Boolean   @default(false)
  homeOrder        Int? // null = pas d'affichage. Sinon trié croissant (1, 2, 3…).
  published        Boolean   @default(false)
  startDate        DateTime?
  endDate          DateTime?

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([destinationId, published])
  @@index([kind, published])
  @@index([promoEndsAt])
}

// ── Réservations ──────────────────────────────────────────────────────

enum ReservationStatus {
  NOUVELLE
  EN_COURS
  CONFIRMEE
  PAYEE
  ANNULEE
  TERMINEE
}

// Commercial follow-up state for every inbound request. This intentionally
// stays separate from ReservationStatus: a paid/confirmed booking can still
// be waiting for a commercial follow-up, and processing a lead must not
// change its payment/booking lifecycle.
enum RequestStatus {
  NOUVEAU
  EN_COURS
  TRAITE
}

/**
 * Source of the reservation — set explicitly by the action that created it.
 * Lets the admin have a single, unified view of all inbound requests
 * (contact form, destination lead, offer quote, flight quote) without
 * having to infer it from `tags` or `offerId`.
 */
enum ReservationSource {
  CONTACT // /contact generic form
  DESTINATION // destination detail page ("Demander un devis")
  OFFER // offer detail page
  FLIGHT // /billetterie (mock or real provider)
}

model Client {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  reservations Reservation[]
}

model Reservation {
  id               String            @id @default(cuid())
  reference        String            @unique // e.g. "AT-2026-00042"
  status           ReservationStatus @default(NOUVELLE)
  processingStatus RequestStatus     @default(NOUVEAU)
  source           ReservationSource @default(CONTACT)
  subject          String?           @db.VarChar(160) // short objet, shown in admin list
  clientAccountId  String?
  clientAccount    ClientAccount?    @relation("ClientAccountReservations", fields: [clientAccountId], references: [id], onDelete: SetNull)

  // Optional assignment to an admin user (agent commercial). Lets the
  // super-admin dispatch new leads and lets each agent see only theirs.
  assigneeId String?
  assignee   AdminUser? @relation("ReservationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Snapshot of the trip at booking time
  travelers Int       @default(1)
  startDate DateTime?
  totalFCFA Int
  notes     String?   @db.Text
  tags      String[]  @default([]) // ["Billetterie"], ["Sur-mesure"], ["Omra"], etc.

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  offerId String?
  offer   Offer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)

  // Direct link to the destination when the lead came from a destination
  // page. Distinct from offer.destinationId — a "Demander un devis" on
  // /destinations/[slug] without picking an offer should still resolve
  // to the right destination in the admin.
  destinationId String?
  destination   Destination? @relation("DestinationReservations", fields: [destinationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([processingStatus])
  @@index([source])
  @@index([assigneeId])
  @@index([destinationId])
  @@index([createdAt])
  @@index([tags])
}

// ── Auth (admin) ──────────────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  AGENT
  COMPTABLE
}

model AdminUser {
  id                   String               @id @default(cuid())
  email                String               @unique
  passwordHash         String
  name                 String
  role                 AdminRole            @default(AGENT)
  twoFactorEnabled     Boolean              @default(false)
  blogPosts            BlogPost[]
  assignedReservations Reservation[]        @relation("ReservationAssignee")
  lastLoginAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  newsletterCampaigns  NewsletterCampaign[]
}

// ── Services (CMS — back-office driven) ──────────────────────────

model Service {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  shortDescription String          @db.VarChar(280)
  longDescription  String?         @db.Text
  category         ServiceCategory
  icon             String? // "stamp" | "hotel" | "car" | "shield" | "transfer" | "briefcase" | "compass"
  imageId          String? // Cloudinary public_id (visuel par défaut)
  priceFromFCFA    Int? // "à partir de" — null = "Sur devis"
  priceNote        String? // ex: "par nuit", "par course"
  order            Int             @default(0)
  isActive         Boolean         @default(true)
  isFeatured       Boolean         @default(false)
  ctaLabel         String? // default "Demander un devis"
  ctaHref          String? // default "/contact?service=<slug>"
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([isActive, order])
  @@index([category, isActive])
}

// ── Visa dossiers (Phase 2 — structure in place) ───────────────────────

enum VisaStatus {
  BROUILLON
  DOCUMENTS_MANQUANTS
  EN_TRAITEMENT
  ACCEPTE
  REFUSE
}

enum ServiceCategory {
  VISA
  HOTELS
  CHAUFFEUR
  ASSURANCE
  TRANSFERT
  ENTREPRISE
  AUTRE
}

model VisaDossier {
  id              String         @id @default(cuid())
  reference       String         @unique
  destination     String // e.g. "Schengen", "USA", "Canada"
  visaType        String? // e.g. "court séjour", "long séjour", "Omra"
  status          VisaStatus     @default(BROUILLON)
  deadline        DateTime?
  appointmentAt   DateTime?
  documents       Json           @default("[]") // [{name, cloudinaryId, uploadedAt}]
  feeFCFA         Int            @default(0)
  paid            Boolean        @default(false)
  clientId        String // FK to Client
  clientAccountId String?
  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([clientId])
  @@index([status])
}

// ── Témoignages ───────────────────────────────────────────────────────

model Testimonial {
  id        String    @id @default(cuid())
  author    String
  city      String?
  content   String    @db.Text
  rating    Int       @default(5)
  tripSlug  String?
  approved  Boolean   @default(false)
  locale    String    @default("fr") // "fr" | "en" — display language
  avatarId  String? // Cloudinary public_id (avatar optionnel)
  dateTrip  DateTime? // date du voyage (optionnel, jamais dans le futur)
  order     Int       @default(0) // tri manuel sur la home
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([approved, locale, order])
}

// ── RBAC extensions ─────────────────────────────────────────────

model TwoFactorCode {
  id        String    @id @default(cuid())
  userId    String
  secret    String // encrypted at rest in production
  confirmed Boolean   @default(false)
  createdAt DateTime  @default(now())
  lastUsed  DateTime?

  @@unique([userId])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // e.g. "reservation.create", "offer.publish"
  entity    String? // e.g. "reservation:abc123"
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model ClientAccount {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  emailVerified Boolean   @default(false)
  verifyToken   String?
  resetToken    String?
  resetExpires  DateTime?
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?

  reservations Reservation[] @relation("ClientAccountReservations")
  visaDossiers VisaDossier[]
}

// ── Site settings (mini-CMS singleton) ────────────────────────

model SiteSetting {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt
}

model FlightConfig {
  // Single-row config for the /billetterie module (admin-editable notes,
  // override contact channels). Provider selection itself stays in
  // FLIGHT_PROVIDER env var — see /docs/flight-provider.md.
  id           String   @id @default("singleton")
  notes        String?  @db.Text // internal notes for the team
  contactEmail String? // optional override for the "Devis reçu" email
  contactPhone String? // optional override phone displayed on admin
  updatedAt    DateTime @updatedAt
}

// ── FAQ (back-office-driven, public listing) ──────────────────

model FaqItem {
  id        String   @id @default(cuid())
  locale    String // "fr" | "en"
  category  String // "general" | "payment" | "visa" | "flight" | "omra" | "services"
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locale, category, order])
  @@index([isActive])
}

// ── Galerie photos (back-office + Cloudinary) ─────────────────────────

model GalleryItem {
  id           String             @id @default(cuid())
  cloudinaryId String             @unique // public_id Cloudinary (ex: "assirik-tours/gallery/artisanat")
  captionFr    String?            @db.VarChar(280)
  captionEn    String?            @db.VarChar(280)
  altText      String // requis pour a11y
  location     String?
  region       DestinationRegion?
  takenAt      DateTime?
  photographer String?
  tags         String[]           @default([])
  order        Int                @default(0)
  isActive     Boolean            @default(true)
  isFeatured   Boolean            @default(false)
  width        Int?
  height       Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([isActive, order])
  @@index([isFeatured])
}

// ── Blog (CMS — Phase Blog) ────────────────────────────────────────────

model BlogPost {
  id           String    @id @default(cuid())
  slug         String
  locale       String // "fr" | "en"
  title        String
  excerpt      String    @db.VarChar(280)
  body         String    @db.Text
  coverImageId String // Cloudinary public_id (or "local:/..." fallback)
  authorId     String
  author       AdminUser @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category     String? // "guides-pratiques" | "destinations" | "visa" | "omra" | "actualites"
  tags         String[]  @default([])
  readingTime  Int? // minutes, optional — calculated on save if absent
  publishedAt  DateTime? // null = brouillon
  isFeatured   Boolean   @default(false)
  seoMeta      Json? // {title?, description?, ogImage?, keywords?}
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([slug, locale])
  @@index([locale, publishedAt])
  @@index([category])
  @@index([authorId])
}

// ── Pages éditoriales (CMS blocs) ────────────────────────────────────

model PageContent {
  id        String   @id @default(cuid())
  slug      String // "about" | "services" | "home-hero" | "home-featured" | ...
  locale    String // "fr" | "en"
  title     String
  subtitle  String?
  blocks    Json // structured blocks: [{type, props}]
  seoMeta   Json? // {title?, description?, ogImage?, keywords?}
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([slug, locale])
  @@index([slug, isActive])
}

// ── Billetterie (recherche de vols via Kiwi Tequila) ──────────────────

model FlightSearch {
  id           String    @id @default(cuid())
  origin       String // IATA code (DSS, DKR, CDG, etc.)
  destination  String // IATA code
  departDate   DateTime
  returnDate   DateTime?
  passengers   Int       @default(1)
  cabinClass   String    @default("ECONOMY")
  provider     String // "kiwi" | "amadeus" | "duffel" | "mock"
  rawResults   Json? // last raw response (debug/audit)
  userId       String? // optionnel si client connecté
  userEmail    String? // pour pouvoir recontacter
  status       String    @default("NEW") // NEW | QUOTE_REQUESTED | RESERVATION_CREATED | ARCHIVED
  quoteName    String?
  quotePhone   String?
  quoteMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  offers FlightOffer[]

  @@index([createdAt])
  @@index([status])
}

model FlightOffer {
  id              String       @id @default(cuid())
  searchId        String
  search          FlightSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  provider        String
  providerOfferId String
  priceAmount     Decimal      @db.Decimal(12, 2)
  priceCurrency   String
  outbound        Json
  inbound         Json?
  passengers      Int
  cabinClass      String
  expiresAt       DateTime
  bookingUrl      String?
  createdAt       DateTime     @default(now())

  @@index([searchId])
}

// ── Communications sortantes (email + SMS + WhatsApp) ─────────────────

model Notification {
  id                String    @id @default(cuid())
  channel           String // "email" | "sms" | "whatsapp"
  templateId        String // "reservation.confirmed" | "payment.received" | ...
  toAddress         String? // email ou téléphone
  toName            String?
  subject           String?
  body              String    @db.Text
  locale            String    @default("fr")
  status            String    @default("queued") // queued | sent | failed | skipped
  provider          String? // "resend" | "twilio" | "whatsapp_cloud" | "noop"
  providerMessageId String?
  errorMessage      String?   @db.Text
  metadata          Json?
  scheduledAt       DateTime?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaignId String?
  campaign   NewsletterCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([channel])
  @@index([templateId])
  @@index([scheduledAt])
  @@index([createdAt])
}

model NewsletterCampaign {
  id           String    @id @default(cuid())
  subjectFr    String
  subjectEn    String
  bodyFr       String    @db.Text
  bodyEn       String    @db.Text
  audience     String // "all" | "vip" | "tag" | "manual"
  audienceTag  String?
  audienceList Json? // when audience="manual": string[] of emails
  status       String    @default("draft") // draft | scheduled | sending | sent | cancelled
  scheduledAt  DateTime?
  sentAt       DateTime?
  recipients   Int       @default(0)
  sent         Int       @default(0)
  failed       Int       @default(0)
  authorId     String
  author       AdminUser @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  notifications Notification[]

  @@index([status])
  @@index([scheduledAt])
  @@index([authorId])
}
