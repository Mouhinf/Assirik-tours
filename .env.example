# =====================================================
# Assirik Tours — Environment variables
# Copy to .env.local and fill in real values.
# =====================================================

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=221775495314

# Auth — generate with: openssl rand -hex 32
AUTH_SECRET=

# Database (Neon / Supabase / Vercel Postgres — free tier)
DATABASE_URL="postgresql://user:password@host:5432/assiriktours?sslmode=require"

# Cloudinary (free tier — 25 credits/month)
# Find these in https://console.cloudinary.com/
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Billetterie aérienne — moteur de recherche de vols
# (search-only, pas de booking — l'agence finalise hors-ligne)
#
# Provider actif : "kiwi" ou "mock" (défaut si pas de clé configurée).
# Pour activer Kiwi, créez un compte sur https://tequila.kiwi.com
# et collez votre clé d'API ci-dessous.
FLIGHT_PROVIDER=mock
KIWI_API_KEY=

# Stripe (optionnel — paiement carte)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Communications sortantes — email + SMS + WhatsApp
#
# Email — Resend (https://resend.com, free 3000/mois + 100/jour)
# Active une fois la clé API générée sur le dashboard.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Assirik Tours <noreply@assiriktours.sn>"

# SMS — Twilio (https://twilio.com, ~0.04€/SMS)
# Achète un numéro expéditeur validé pour le Sénégal (+221).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# WhatsApp Cloud API (Meta Business, free 1000 conversations/mois service)
# Nécessite un compte Meta Business vérifié + token d'accès.
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
